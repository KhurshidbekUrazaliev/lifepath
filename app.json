{
  "expo": {
    "name": "Lifepath",
    "slug": "lifepath",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "lifepath",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.urazaliev.lifepath"
    },
    "android": {
      "package": "com.urazaliev.lifepath"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "43d7c263-3989-45fb-bd23-3fa43a1978ac"
      }
    }
  }
}
